# Local development connection URL. Use your own credentials; never commit .env.
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/job_match

# Docker Compose uses these to create the database and build DATABASE_URL for the API.
POSTGRES_DB=job_match
POSTGRES_USER=job_match
POSTGRES_PASSWORD=change-this-local-password

# Optional weights. They must be non-negative and sum to 100.
SCORING_SKILLS_WEIGHT=50
SCORING_EXPERIENCE_WEIGHT=20
SCORING_LOCATION_WEIGHT=15
SCORING_SALARY_WEIGHT=15
